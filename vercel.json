{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd \"DataBounty Frontend\" && npm install && npm run build",
  "outputDirectory": "DataBounty Frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
